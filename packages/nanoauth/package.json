{
  "name": "nanoauth",
  "version": "0.0.1",
  "description": "Lightweight, extensible authentication library for TypeScript",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./plugins/session": {
      "types": "./src/plugins/session.ts",
      "import": "./src/plugins/session.ts",
      "default": "./src/plugins/session.ts"
    },
    "./plugins/email-password": {
      "types": "./src/plugins/email-password.ts",
      "import": "./src/plugins/email-password.ts",
      "default": "./src/plugins/email-password.ts"
    },
    "./plugins/oauth": {
      "types": "./src/plugins/oauth.ts",
      "import": "./src/plugins/oauth.ts",
      "default": "./src/plugins/oauth.ts"
    },
    "./plugins/magic-link": {
      "types": "./src/plugins/magic-link.ts",
      "import": "./src/plugins/magic-link.ts",
      "default": "./src/plugins/magic-link.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts",
      "default": "./src/react.ts"
    }
  },
  "devDependencies": {
    "hono": "latest",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "hono": ">=4.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@nanostores/react": "^0.8.4",
    "@oslojs/binary": "latest",
    "@oslojs/crypto": "latest",
    "@oslojs/encoding": "latest",
    "@oslojs/jwt": "latest",
    "@oslojs/oauth2": "latest",
    "@oslojs/otp": "latest",
    "@oslojs/webauthn": "latest",
    "arctic": "^3.7.0",
    "nanostores": "^0.11.3"
  },
  "keywords": [
    "auth",
    "authentication",
    "typescript",
    "plugin",
    "extensible"
  ],
  "author": "",
  "license": "MIT"
}
