{
  "name": "nanoauth",
  "version": "0.0.1",
  "description": "Lightweight, extensible authentication library for TypeScript",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugins/session": {
      "types": "./src/plugins/session.ts",
      "import": "./src/plugins/session.ts",
      "default": "./src/plugins/session.ts"
    },
    "./plugins/email-password": {
      "types": "./src/plugins/email-password.ts",
      "import": "./src/plugins/email-password.ts",
      "default": "./src/plugins/email-password.ts"
    },
    "./plugins/oauth": {
      "types": "./src/plugins/oauth.ts",
      "import": "./src/plugins/oauth.ts",
      "default": "./src/plugins/oauth.ts"
    },
    "./hono": {
      "types": "./src/integrations/hono.ts",
      "import": "./src/integrations/hono.ts",
      "default": "./src/integrations/hono.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "Remove-Item -Path dist -Recurse -Force -ErrorAction SilentlyContinue",
    "test": "bun test src tests --ignore-path dist",
    "test:watch": "bun test src tests --ignore-path dist --watch"
  },
  "devDependencies": {
    "hono": "latest",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "dependencies": {
    "@oslojs/binary": "latest",
    "@oslojs/crypto": "latest",
    "@oslojs/encoding": "latest",
    "@oslojs/oauth2": "latest",
    "@oslojs/otp": "latest",
    "@oslojs/jwt": "latest",
    "@oslojs/webauthn": "latest"
  },
  "keywords": [
    "auth",
    "authentication",
    "typescript",
    "plugin",
    "extensible"
  ],
  "author": "",
  "license": "MIT"
}
