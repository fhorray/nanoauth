# 🛰️ NanoAuth Playground - Environment Variables Template
# Copy this file to '.dev.vars' and fill in your actual keys.

# --- CORE AUTH ---
# Secret key used for JWT (HS256) and session signing.
# Generate a secure string for production.
AUTH_SECRET=playground-secret-key-12345

# --- STRIPE INTEGRATION ---
# Your Stripe Secret Key (starts with sk_test_...)
STRIPE_SECRET_KEY=sk_test_placeholder

# Your Stripe Webhook Signing Secret (starts with whsec_...)
# Obtain this by running 'stripe listen --forward-to localhost:3000/api/auth/stripe/webhook'
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- DATABASE ---
# Path to your SQLite database file for Drizzle / Bun:Sqlite
DATABASE_URL=playground.db

# --- APPLICATION ---
# The base URL of your application, used for OAuth redirects and Stripe success/cancel URLs.
APP_URL=http://localhost:3000
